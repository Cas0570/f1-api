    drivers ||--o{ race_results : "drives"
    sessions ||--o{ lap_times : "recorded"
    drivers ||--o{ lap_times : "set by"
    lap_times ||--o{ sector_times : "divided into"
    
    %% Gen 8 new relationships
    sessions ||--o{ telemetry : "telemetry captured"
    drivers ||--o{ telemetry : "from driver car"
    
    lap_times ||--o{ mini_sectors : "24 segments per lap"
    drivers ||--o{ mini_sectors : "performance data"
    
    sessions ||--o{ intervals : "live gaps tracked"
    drivers ||--o{ intervals : "for driver"
    
    sessions ||--o{ team_radio : "communications"
    drivers ||--o{ team_radio : "from driver"