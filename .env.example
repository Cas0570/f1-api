# Database
DATABASE_URL="postgresql://username:password@localhost:5432/f1_api?schema=public"

# Server
NODE_ENV="development"
PORT=3000
HOST="0.0.0.0"

# API
API_VERSION="v1"

# Logging
LOG_LEVEL="info"

# CORS (comma-separated)
CORS_ORIGIN="http://localhost:3000,http://localhost:5173"

# Rate Limiting (Gen 3+)
# RATE_LIMIT_MAX=100
# RATE_LIMIT_WINDOW=900000